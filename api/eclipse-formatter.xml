<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Java formatter profile, shared by VS Code (java.format.settings.url) and Spotless (./gradlew spotlessApply). -->
<profiles version="23">
  <profile kind="CodeFormatterProfile" name="Chanko" version="23">
    <!-- 2-space indentation, no tabs -->
    <setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
    <setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="2"/>
    <setting id="org.eclipse.jdt.core.formatter.indentation.size" value="2"/>
    <!-- Wrapped lines get one extra indent level, not two -->
    <setting id="org.eclipse.jdt.core.formatter.continuation_indentation" value="1"/>
    <setting id="org.eclipse.jdt.core.formatter.continuation_indentation_for_array_initializer" value="1"/>
    <!-- Max line width; longer expressions are wrapped -->
    <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="100"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.line_length" value="100"/>
    <!-- Allow wrapping inside annotation arguments and between parameter annotations (Eclipse default never wraps these) -->
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_arguments_in_annotation" value="16"/>
    <setting id="org.eclipse.jdt.core.formatter.alignment_for_annotations_on_parameter" value="16"/>
    <!-- Keep line breaks written by hand (e.g. one call per line in stream chains) -->
    <setting id="org.eclipse.jdt.core.formatter.join_wrapped_lines" value="false"/>
    <!-- Leave comment text as written -->
    <setting id="org.eclipse.jdt.core.formatter.comment.format_javadoc_comments" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.format_block_comments" value="false"/>
    <setting id="org.eclipse.jdt.core.formatter.comment.format_line_comments" value="false"/>
  </profile>
</profiles>
