# Copy to .env and fill in real values. Never commit .env.

# ---------- Postgres (used by docker-compose and Spring) ----------
POSTGRES_DB=chanko
POSTGRES_USER=chanko
POSTGRES_PASSWORD=chanko
DATABASE_URL=jdbc:postgresql://localhost:5432/chanko

# ---------- Google OAuth (filled in when SSO is wired up) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:8080
